    [ "bzHr:2",     "esp:D16",   "green", [ "v0" ] ],
    [ "bzSpo2:1",   "esp:GND.1", "black", [ "v0" ] ],
    [ "bzSpo2:2",   "esp:D17",   "green", [ "v0" ] ],
    [ "bzSystem:1", "esp:GND.1", "black", [ "v0" ] ],
    [ "bzSystem:2", "esp:D5",    "green", [ "v0" ] ],

    [ "swTemp:1",   "esp:GND.3", "black", [ "v0" ] ],
    [ "swTemp:2",   "esp:D32",   "gold",  [ "v0" ] ],
    [ "swTemp:3",   "esp:3V3",   "red",   [ "v0" ] ],
    [ "swHr:1",     "esp:GND.3", "black", [ "v0" ] ],
    [ "swHr:2",     "esp:D33",   "gold",  [ "v0" ] ],
    [ "swHr:3",     "esp:3V3",   "red",   [ "v0" ] ],
    [ "swSpo2:1",   "esp:GND.3", "black", [ "v0" ] ],
    [ "swSpo2:2",   "esp:D25",   "gold",  [ "v0" ] ],
    [ "swSpo2:3",   "esp:3V3",   "red",   [ "v0" ] ],
    [ "swMotion:1", "esp:GND.3", "black", [ "v0" ] ],
