      "attrs": { "value": "700" } },
    { "type": "wokwi-potentiometer", "id": "potAqi", "top": 130, "left": 430,
      "attrs": { "value": "200" } },

    { "type": "wokwi-buzzer", "id": "bzTemp",   "top": 300, "left": 60,  "attrs": { "volume": "0.1" } },
    { "type": "wokwi-buzzer", "id": "bzHr",     "top": 300, "left": 130, "attrs": { "volume": "0.1" } },
