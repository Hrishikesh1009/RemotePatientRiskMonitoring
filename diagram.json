    { "type": "wokwi-resistor", "id": "rDose", "top": 100, "left": 240,
      "attrs": { "value": "220" } },

    { "type": "wokwi-led", "id": "ledOk", "top": 60, "left": 300,
      "attrs": { "color": "green", "label": "OK" } },
    { "type": "wokwi-resistor", "id": "rOk", "top": 100, "left": 300,
      "attrs": { "value": "220" } },

    { "type": "wokwi-led", "id": "ledNet", "top": 60, "left": 360,
      "attrs": { "color": "yellow", "label": "LINK" } },
    { "type": "wokwi-resistor", "id": "rNet", "top": 100, "left": 360,
      "attrs": { "value": "220" } }
  ],

  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "oled:GND", "esp:GND.1", "black", [ "v0" ] ],
