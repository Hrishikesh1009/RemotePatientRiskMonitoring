{
  "version": 1,
  "author": "Hrishikesh Lokhande",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },

    { "type": "wokwi-ssd1306", "id": "oled", "top": -140, "left": 240,
      "attrs": { "i2cAddress": "0x3c" } },

    { "type": "wokwi-ds18b20", "id": "bodyTemp", "top": 130, "left": -230,
      "attrs": { "temperature": "36.8" } },
    { "type": "wokwi-resistor", "id": "rTemp", "top": 100, "left": -140,
      "attrs": { "value": "4700" } },

    { "type": "wokwi-dht22", "id": "roomEnv", "top": -150, "left": -230,
      "attrs": { "temperature": "22", "humidity": "45" } },

    { "type": "wokwi-pir-motion-sensor", "id": "pir", "top": 250, "left": -240, "attrs": {} },

    { "type": "wokwi-potentiometer", "id": "potEcg", "top": -90, "left": 430,
